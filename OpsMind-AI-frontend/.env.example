# MongoDB Atlas connection string (M10+ cluster required for Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/opsmind

# Groq API key — get from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT secret — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Frontend: backend API base URL (used by Vite at build time)
# Override per environment:
#   .env.development  → http://localhost:5000
#   .env.staging      → https://api-staging.opsmind.example.com
#   .env.production   → https://api.opsmind.example.com
VITE_API_BASE=http://localhost:5000

# Set to true ONLY when running: npm run eval
# Never set this in production — it disables auth on /ask
EVAL_MODE=false

# JWT token for eval script when EVAL_MODE=false
# Get it by calling POST /auth/login and copying the token field
EVAL_JWT_TOKEN=

# Secret for the one-time POST /auth/seed endpoint
# Unset this after seeding your initial users in production
SEED_SECRET=change-me-before-seeding
